<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C7D8EA">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#F1575D"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/button_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Go back"
        app:layout_constraintBottom_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toStartOf="@id/top_bar"
        app:layout_constraintTop_toTopOf="@id/top_bar"
        app:srcCompat="@drawable/ic_arrow_back" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="PunctuOwlity logo"
                android:src="@drawable/punctuowlity_logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/cormorant_upright_bold"
                android:text="Add/Edit An Event"
                android:textAlignment="center"
                android:textColor="#000050"
                android:textSize="36sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_event_title"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:background="#FFFFFF"
                android:hint="Enter event title"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="#000050"
                android:textColorHint="#555555" />

            <EditText
                android:id="@+id/edit_event_date"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:background="#FFFFFF"
                android:hint="Date (MM/DD/YYYY)"
                android:inputType="date"
                android:paddingHorizontal="12dp"
                android:textColor="#000050"
                android:textColorHint="#555555"         android:focusable="false"
        android:clickable="true"
        android:cursorVisible="false"
/>

            <EditText
                android:id="@+id/edit_event_time"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:background="#FFFFFF"
                android:hint="Time (for example, 1:30 PM)"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="#000050"
                android:textColorHint="#555555"         android:focusable="false"
        android:clickable="true"
        android:cursorVisible="false"
/>

            <Spinner
                android:id="@+id/spinner_category"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:background="#FFFFFF"
                android:entries="@array/event_categories_labels"
                android:spinnerMode="dropdown" />

            <Switch
                android:id="@+id/switch_alert"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/aref_ruqaa"
                android:text="Remind me about this event"
                android:textColor="#000050"
                android:textSize="18sp" />

            <Button
                android:id="@+id/button_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:backgroundTint="#2FC7C9"
                android:text="Save Event"
                android:textColor="#000050" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
